# Copy to .env.local for local overrides. On Vercel, set these under
# Project → Settings → Environment Variables. None are required for a
# first deploy.

# Public origin of the site, no trailing slash. Leave unset on Vercel until
# the real domain is attached; the *.vercel.app production URL is used
# automatically.
# NEXT_PUBLIC_SITE_URL=https://kertzdigital.com

# Allow search engines to index the site. Leave unset (off) until the real
# domain, phone number, and copy are live. Set to "true" on Production only.
# NEXT_PUBLIC_ALLOW_INDEXING=true

# ── Search Console ──────────────────────────────────────────────────────────
# Content value from Google Search Console's "HTML tag" verification method.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=abc123

# ── Analytics ───────────────────────────────────────────────────────────────
# Vercel Web Analytics + Speed Insights: turn on in the Vercel dashboard, no
# variable needed. Optional GA4 (free conversion tracking, needed for Google
# Ads later):
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Booking form delivery (server-side only, never exposed to the browser) ──
# A lead is "sent" if at least one of these channels accepts it. If none is
# set in production, the form tells visitors to call instead.
#
# 1) Email via Resend (resend.com, free tier is plenty). Verify your domain in
#    Resend to send from it; until then onboarding@resend.dev works.
# RESEND_API_KEY=re_xxxxxxxx
# LEAD_EMAIL_TO=you@kertzdigital.com
# LEAD_EMAIL_FROM=Kertz Digital <leads@kertzdigital.com>
#
# 2) Webhook to the communications bot. Each POST is JSON
#    { type: "lead.created", id, receivedAt, site, lead: {...} }
#    with headers X-Kertz-Timestamp and
#    X-Kertz-Signature: sha256=HMAC_SHA256(secret, `${timestamp}.${rawBody}`)
# COMMS_WEBHOOK_URL=https://comms.kertzdigital.com/hooks/lead
# COMMS_WEBHOOK_SECRET=generate-a-long-random-string

# ── On-site scheduler (self-hosted Easy!Appointments, see kertz-booking) ────
# Server-side only. When both are set, /book shows a day/time picker that
# books straight into the booking server. Token: booking admin → Settings → API.
# BOOKING_API_URL=https://35-239-184-220.sslip.io
# BOOKING_API_TOKEN=
# Optional: which service to book if there's more than one (defaults to the first public one).
# BOOKING_SERVICE_ID=
