# Copy to .env.local for local overrides. On Vercel, set these under
# Project → Settings → Environment Variables. None are required for a
# first deploy.

# Public origin of the site, no trailing slash. Leave unset on Vercel until
# the real domain is attached; the *.vercel.app production URL is used
# automatically.
# NEXT_PUBLIC_SITE_URL=https://kertzdigital.com

# Allow search engines to index the site. Leave unset (off) until the real
# domain, phone number, and copy are live. Set to "true" on Production only.
# NEXT_PUBLIC_ALLOW_INDEXING=true
